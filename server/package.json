{
  "name": "ics-creator-server",
  "version": "1.0.0",
  "private": true,
  "description": "엑셀 번역 시트를 국가별 .ics 파일로 변환하는 서버",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "build:exe": "npm run bundle && pkg build/server.cjs --config package.json --targets node22-win-x64 --output ../dist/ics-creator.exe",
    "bundle": "esbuild src/index.js --bundle --platform=node --target=node22 --format=cjs --outfile=build/server.cjs",
    "sample": "node scripts/make-sample.js"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "jszip": "^3.10.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "esbuild": "^0.28.2"
  }
}
